{
  "name": "onboarding",
  "steps": [
    {
      "id": "open-app",
      "type": "act",
      "title": "open the Numbra app"
    },
    {
      "id": "welcome-shown",
      "type": "assert",
      "title": "the onboarding screen is shown with a Continue button"
    },
    {
      "id": "continue-1",
      "type": "act",
      "title": "tap \"Continue\""
    },
    {
      "id": "continue-2",
      "type": "act",
      "title": "tap \"Continue\""
    },
    {
      "id": "try-free",
      "type": "act",
      "title": "tap \"Try it free\""
    },
    {
      "id": "photo-pick-shown",
      "type": "assert",
      "title": "the photo picker screen is shown with a \"Choose from library\" button"
    }
  ]
}
