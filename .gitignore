# Xcode / build output
build/
DerivedData/
*.xcuserstate
xcuserdata/

# Generated by XcodeGen from project.yml (CI runs `xcodegen generate`)
Numbra.xcodeproj/

# macOS
.DS_Store

# mobai-ci reports + local logs
reports/
mobai-ci-out/
.mobai-logs/
.debug-logs/
# `screenshot "<label>"` writes ./<label>/screenshot_*.png in the cwd
screenshot_*.png

# Large local media / demo artifacts (not source)
*.mp4
demo-out/
remotion-brand/

# CI credentials never belong in git
*.env

# Local Swift toolchain artifacts (swiftly, used by the mobai preview engine)
.swift-version
swiftly-*.tar.gz

# mobai preview engine scratch.
# The engine anchors a workspace at the entry file's own directory, so
# previewing e.g. Sources/UI/Components.swift creates Sources/UI/.mobai/.
# Those hold only the engine's own .gitignore plus a rebuilt SwiftPM tree.
# Sources/.mobai/ is NOT ignored: the stand-ins and adapters there are
# authored, and its own .gitignore already excludes the scratch inside it.
Sources/*/.mobai/
.mobai/preview.state
